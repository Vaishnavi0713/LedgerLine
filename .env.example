# ==============================================================================
# LedgerLine — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and supply secure values before starting the application.
# NEVER commit the actual '.env' file to source control.
# ==============================================================================

# Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ledgerline_db

# Application Runtime User (Least Privilege: DML only, No DDL, No UPDATE/DELETE on ledger)
DB_APP_USER=ledgerline_app
DB_APP_PASSWORD=PLACEHOLDER_APP_USER_PASSWORD_MIN_16_CHARS

# Database Migration User (Used exclusively by Flyway for schema management)
DB_MIGRATOR_USER=ledgerline_migrator
DB_MIGRATOR_PASSWORD=PLACEHOLDER_MIGRATOR_PASSWORD_MIN_16_CHARS

# Dedicated Routine Definer (Narrow DML scope for stored procedures; no DDL, no GRANT)
DB_DEFINER_USER=ledgerline_definer
DB_DEFINER_PASSWORD=PLACEHOLDER_DEFINER_PASSWORD_MIN_16_CHARS

# Database Root Password (Used exclusively for container initialization)
DB_ROOT_PASSWORD=PLACEHOLDER_ROOT_PASSWORD_MIN_16_CHARS

# JWT Authentication (HMAC-SHA256 Secret: minimum 256 bits / 32 bytes)
JWT_SECRET=PLACEHOLDER_JWT_SECRET_GENERATE_USING_SECURE_RANDOM_BASE64
JWT_EXPIRATION_MS=86400000

# Demo Account Credentials (Required for evaluator initial seeding; min 12 characters)
DEMO_ADMIN_PASSWORD=PLACEHOLDER_EVALUATOR_ADMIN_PASSWORD_MIN_12_CHARS
DEMO_HOLDER_PASSWORD=PLACEHOLDER_EVALUATOR_HOLDER_PASSWORD_MIN_12_CHARS
DEMO_AUDITOR_PASSWORD=PLACEHOLDER_EVALUATOR_AUDITOR_PASSWORD_MIN_12_CHARS

# Server and Client Ports
SERVER_PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api/v1
